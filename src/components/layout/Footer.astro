---
import { NAV_LINKS, type PageId } from "../../i18n/config";
import { PRIVACY_URL } from "../../data/contacts";
import { getLang, localePath, useTranslations } from "../../i18n/t";
import { logoLink, wrap } from "../../lib/ui";
import Logo from "./Logo.astro";

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const homeHref = localePath(lang);
---

<footer class="bg-blue-dark pt-8 pb-4 text-[13px] text-white/82" id="stores">
  <div class={`${wrap} flex items-center gap-x-6 max-[600px]:items-start`}>
    <nav class="flex min-w-0 flex-wrap items-center gap-x-6 gap-y-3 font-semibold max-[600px]:flex-col max-[600px]:items-start max-[600px]:gap-y-2.5">
      <a class={logoLink} href={homeHref} aria-label="UNEMDE">
        <Logo gradId="footGrad" light />
      </a>
      {
        NAV_LINKS.map((item) => (
          <a
            class="hover:text-white aria-[current=page]:text-white"
            href={localePath(lang, item.path)}
            aria-current={page === item.page ? "page" : undefined}
          >
            {t(item.key)}
          </a>
        ))
      }
    </nav>
  </div>
  <div
    class={`${wrap} mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-white/12 pt-3 text-white/60 max-[600px]:flex-col max-[600px]:items-start`}
  >
    <span>{t("footer.rights")}</span>
    <a class="hover:text-white" href={PRIVACY_URL} target="_blank" rel="noreferrer">{t("footer.privacy")}</a>
    <span class="min-[601px]:ml-auto">{t("footer.note")}</span>
  </div>
</footer>
