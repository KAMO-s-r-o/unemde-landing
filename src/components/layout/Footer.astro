---
import { NAV_LINKS, type PageId } from "../../i18n/config";
import { INSTAGRAM_URL, LINKEDIN_URL, TIKTOK_URL } from "../../data/contacts";
import { logoLink, wrap } from "../../lib/ui";
import Logo from "./Logo.astro";

interface Props {
  page: PageId;
}

const { page } = Astro.props;

const socialLink =
  "inline-flex size-9 shrink-0 items-center justify-center rounded-[10px] border border-white/28 bg-white/14 text-white transition duration-200 hover:-translate-y-px hover:bg-white/22";
---

<footer class="bg-blue-dark pt-8 pb-4 text-[13px] text-white/82" id="stores">
  <div class={`${wrap} flex items-center justify-between gap-x-6 max-[600px]:items-start`}>
    <nav class="flex min-w-0 flex-wrap items-center gap-x-6 gap-y-3 font-semibold max-[600px]:flex-col max-[600px]:items-start max-[600px]:gap-y-2.5">
      <a class={logoLink} href="/" aria-label="UNEMDE">
        <Logo gradId="footGrad" light />
      </a>
      {
        NAV_LINKS.map((item) => (
          <a
            class="hover:text-white aria-[current=page]:text-white"
            href={item.href}
            aria-current={page === item.page ? "page" : undefined}
            data-i18n={item.key}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex shrink-0 items-center gap-2">
      <a
        class={socialLink}
        href={LINKEDIN_URL}
        target="_blank"
        rel="noreferrer"
        data-i18n="footer.linkedin"
        data-i18n-attr="aria-label"
        aria-label="LinkedIn"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.25h4.52V24H.24zM8.34 8.25h4.33v2.14h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.93V24h-4.52v-7.69c0-1.83-.03-4.19-2.55-4.19-2.55 0-2.94 1.99-2.94 4.05V24H8.34z"
          ></path>
        </svg>
      </a>
      <a
        class={socialLink}
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noreferrer"
        data-i18n="footer.instagram"
        data-i18n-attr="aria-label"
        aria-label="Instagram"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
          ></path>
        </svg>
      </a>
      <a
        class={socialLink}
        href={TIKTOK_URL}
        target="_blank"
        rel="noreferrer"
        data-i18n="footer.tiktok"
        data-i18n-attr="aria-label"
        aria-label="TikTok"
      >
        <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.16 15.3a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.73a8.2 8.2 0 0 0 4.79 1.52V6.79a4.85 4.85 0 0 1-1.04-.1z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
  <div
    class={`${wrap} mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-white/12 pt-3 text-white/60 max-[600px]:flex-col max-[600px]:items-start`}
  >
    <span data-i18n="footer.rights">© 2026 UNEMDE</span>
    <a class="hover:text-white" href="/private-policy" data-i18n="footer.privacy">Privacy policy</a>
    <span class="min-[601px]:ml-auto" data-i18n="footer.note">
      Guests and venues · local deals · on-site activation
    </span>
  </div>
</footer>
