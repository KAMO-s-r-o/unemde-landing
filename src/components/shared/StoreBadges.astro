---
import { APPSTORE_URL, GOOGLEPLAY_URL } from "../../data/contacts";
import { useTranslations } from "../../i18n/t";
import { storeBadge } from "../../lib/ui";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<div class:list={["flex flex-wrap items-center gap-3", className]}>
  <a class={storeBadge} href={APPSTORE_URL} target="_blank" rel="noreferrer">
    <img class="h-12 w-auto" src="/imgs/app-store.jpg" alt={t("guest.storeApp")} />
  </a>
  <a class={storeBadge} href={GOOGLEPLAY_URL} target="_blank" rel="noreferrer">
    <img class="h-12 w-auto" src="/imgs/google-play.jpg" alt={t("guest.storePlay")} />
  </a>
</div>
