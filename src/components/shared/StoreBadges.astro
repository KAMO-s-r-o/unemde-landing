---
import { ANDROID_APK_URL, APPSTORE_URL } from "../../data/contacts";
import { useTranslations } from "../../i18n/t";
import { btnGreen, storeBadge } from "../../lib/ui";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<div class:list={["flex flex-wrap items-center gap-3", className]}>
  <a class={storeBadge} href={APPSTORE_URL}>
    <img class="h-12 w-auto" src="/imgs/app-store.jpg" alt={t("guest.storeApp")} />
  </a>
  <!-- Google Play badge temporarily hidden
  <a class={storeBadge} href={GOOGLEPLAY_URL}>
    <img class="h-12 w-auto" src="/imgs/google-play.jpg" alt={t("guest.storePlay")} />
  </a>
  -->
  <a
    class={btnGreen}
    href={ANDROID_APK_URL}
    download="UNEMDE.apk"
  >{t("guest.storeAndroid")}</a>
</div>
